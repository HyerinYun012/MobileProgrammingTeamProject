<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_author_profile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:srcCompat="@drawable/union"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_comment_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/nanum_gothic_bold"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/iv_author_profile"
        app:layout_constraintTop_toTopOf="@id/iv_author_profile" />

    <TextView
        android:id="@+id/tv_owner_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="#FFE0B2"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="사장님"
        android:textColor="#E65100"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_comment_author"
        app:layout_constraintStart_toEndOf="@id/tv_comment_author"
        app:layout_constraintTop_toTopOf="@id/tv_comment_author" />

    <TextView
        android:id="@+id/tv_badge_customer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="#ECECEC"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="고객님"
        android:textColor="#7C7C7C"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_comment_author"
        app:layout_constraintStart_toEndOf="@id/tv_comment_author"
        app:layout_constraintTop_toTopOf="@id/tv_comment_author" />

    <TextView
        android:id="@+id/tv_post_author_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="#FF8A4C"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="글쓴이"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_comment_author"
        app:layout_constraintStart_toEndOf="@id/tv_owner_badge"
        app:layout_constraintTop_toTopOf="@id/tv_comment_author" />

    <TextView
        android:id="@+id/btn_edit_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:padding="4dp"
        android:text="수정"
        android:textColor="#888888"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_comment_author"
        app:layout_constraintEnd_toStartOf="@id/btn_delete_comment"
        app:layout_constraintTop_toTopOf="@id/tv_comment_author" />

    <TextView
        android:id="@+id/btn_delete_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="삭제"
        android:textColor="#FF5252"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_comment_author"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_comment_author" />

    <TextView
        android:id="@+id/btn_report_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="신고"
        android:textColor="#FF5252"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_comment_author"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_comment_author" />

    <TextView
        android:id="@+id/tv_comment_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#999999"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_comment_author"
        app:layout_constraintTop_toBottomOf="@id/tv_comment_author" />

    <TextView
        android:id="@+id/tv_comment_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#555555"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_comment_author"
        app:layout_constraintTop_toBottomOf="@id/tv_comment_date" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_edit_comment_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#F9F9F9"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_comment_author"
        app:layout_constraintTop_toBottomOf="@id/tv_comment_date">

        <EditText
            android:id="@+id/et_edit_comment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:hint="수정할 내용을 입력하세요"
            android:inputType="textMultiLine"
            android:minHeight="48dp"
            android:padding="8dp"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn_cancel_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:text="취소"
            android:textColor="#888888"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btn_save_edit"
            app:layout_constraintTop_toBottomOf="@id/et_edit_comment" />

        <TextView
            android:id="@+id/btn_save_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nanum_gothic_bold"
            android:text="저장"
            android:textColor="#FF8A4C"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_edit_comment" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/comment_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#F0F0F0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_comment_content" />

</androidx.constraintlayout.widget.ConstraintLayout>
