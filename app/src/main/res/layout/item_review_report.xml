<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_border_orange"
    android:padding="20dp">

    <ImageView
        android:id="@+id/iv_reviewer_profile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_profile_dog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_reviewer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/nanum_gothic_bold"
        android:text="신고자 이름"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_reviewer_profile"
        app:layout_constraintStart_toEndOf="@id/iv_reviewer_profile"
        app:layout_constraintTop_toTopOf="@id/iv_reviewer_profile" />

    <LinearLayout
        android:id="@+id/layout_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/tv_reviewer_name"
        app:layout_constraintStart_toEndOf="@id/tv_reviewer_name"
        app:layout_constraintTop_toTopOf="@id/tv_reviewer_name">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" android:layout_marginEnd="4dp"/>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" android:layout_marginEnd="4dp"/>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" android:layout_marginEnd="4dp"/>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" android:layout_marginEnd="4dp"/>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_arrow_right_orange"
        app:layout_constraintBottom_toBottomOf="@id/iv_reviewer_profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_reviewer_profile" />

    <TextView
        android:id="@+id/tv_review_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="@font/nanum_gothic_regular"
        android:text="리뷰 내용이 들어갈 자리입니다."
        android:textColor="#000000"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_delete_review"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_reviewer_profile" />

    <TextView
        android:id="@+id/btn_delete_review"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_solid_orange"
        android:fontFamily="@font/nanum_gothic_bold"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="13dp"
        android:text="삭제"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_reviewer_profile"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>