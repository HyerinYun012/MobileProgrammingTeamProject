<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/verticalLine1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/gray"
        app:layout_constraintBottom_toTopOf="@+id/textViewRecent2"
        app:layout_constraintEnd_toStartOf="@+id/textViewRecent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecent"
        app:layout_constraintVertical_bias="0.0" />
    <View
        android:id="@+id/verticalLine2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="16dp"
        android:background="@color/gray"
        android:backgroundTint="@color/orange"
        app:layout_constraintEnd_toStartOf="@+id/textViewRecent2"
        app:layout_constraintHorizontal_bias="0.165"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecent2" />
    <View
        android:id="@+id/verticalLine3"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="-8dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/textViewRecent"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecent" />
    <View
        android:id="@+id/verticalLine4"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="-8dp"
        android:background="#E0E0E0"
        android:backgroundTint="@color/orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/textViewRecent2"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecent2" />

    <TextView
        android:id="@+id/textViewRecent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nanum_gothic_bold"
        android:text="@string/recent_search_word"
        android:textAlignment="viewEnd"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04000002" />

    <TextView
        android:id="@+id/textViewRecent2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nanum_gothic_bold"
        android:text="@string/recommend_search_word"
        android:textAlignment="viewEnd"
        android:textColor="@color/orange"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.198"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecent"
        app:layout_constraintVertical_bias="0.100000024" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/textViewRecent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0">

    </ScrollView>

    <ScrollView
        android:id="@+id/scrollView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/textViewRecent2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecent"
        app:layout_constraintVertical_bias="0.22000003">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/textViewRecent"
            tools:layout_editor_absoluteX="4dp">

            <Button
                android:id="@+id/btnRecent"
                android:layout_width="100dp"
                android:layout_height="35dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/edge_round_gray"
                android:fontFamily="@font/nanum_gothic_bold"
                android:text="검색어1"
                android:textAlignment="center"
                android:textColor="@color/gray"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/recommendLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:padding="12dp"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecent2">

        <Button
            android:id="@+id/btnRecommend1"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/edge_round_orange"
            android:fontFamily="@font/nanum_gothic_bold"
            android:text="추천 검색어1"
            android:textAlignment="center"
            android:textColor="@color/orange"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRecommend2"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/edge_round_orange"
            android:fontFamily="@font/nanum_gothic_bold"
            android:text="추천 검색어2"
            android:textAlignment="center"
            android:textColor="@color/orange"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRecommend3"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/edge_round_orange"
            android:fontFamily="@font/nanum_gothic_bold"
            android:text="추천 검색어3"
            android:textAlignment="center"
            android:textColor="@color/orange"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRecommend4"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/edge_round_orange"
            android:fontFamily="@font/nanum_gothic_bold"
            android:text="추천 검색어4"
            android:textAlignment="center"
            android:textColor="@color/orange"
            android:textSize="14sp" />
    </com.google.android.flexbox.FlexboxLayout>

</androidx.constraintlayout.widget.ConstraintLayout>