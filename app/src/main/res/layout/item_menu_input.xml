<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_edit_gray"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btn_remove_item"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_label_name"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="메뉴이름"
        android:textColor="#000000"
        android:textSize="16sp"
        android:fontFamily="@font/nanum_gothic_bold"
        app:layout_constraintTop_toTopOf="@id/et_menu_name"
        app:layout_constraintBottom_toBottomOf="@id/et_menu_name"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_menu_name"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_edit_selector"
        android:paddingHorizontal="12dp"
        android:textColor="#000000"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_label_name"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_item"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/tv_label_price"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="메뉴가격"
        android:textColor="#000000"
        android:textSize="16sp"
        android:fontFamily="@font/nanum_gothic_bold"
        app:layout_constraintTop_toTopOf="@id/et_menu_price"
        app:layout_constraintBottom_toBottomOf="@id/et_menu_price"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_menu_price"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="35dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_edit_selector"
        android:paddingHorizontal="12dp"
        android:textColor="#000000"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/et_menu_name"
        app:layout_constraintStart_toEndOf="@id/tv_label_price"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/tv_label_desc"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="한줄소개"
        android:textColor="#000000"
        android:textSize="16sp"
        android:fontFamily="@font/nanum_gothic_bold"
        app:layout_constraintTop_toTopOf="@id/et_menu_desc"
        app:layout_constraintBottom_toBottomOf="@id/et_menu_desc"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_menu_desc"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="35dp"
        android:background="@drawable/bg_edit_selector"
        android:paddingHorizontal="12dp"
        android:textColor="#000000"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/et_menu_price"
        app:layout_constraintStart_toEndOf="@id/tv_label_desc"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_label_photo"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:text="메뉴사진"
        android:textColor="#000000"
        android:textSize="16sp"
        android:fontFamily="@font/nanum_gothic_bold"
        app:layout_constraintTop_toTopOf="@id/iv_menu_photo"
        app:layout_constraintBottom_toBottomOf="@id/iv_menu_photo"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_menu_photo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add_photo"
        app:layout_constraintTop_toBottomOf="@id/et_menu_desc"
        app:layout_constraintStart_toEndOf="@id/tv_label_photo" />

</androidx.constraintlayout.widget.ConstraintLayout>