<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#D9D9D9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/nanum_gothic_bold"
        android:text="시간 선택"
        android:textColor="#FF8A4C"
        android:textSize="22sp" />

    <RadioGroup
        android:id="@+id/rg_ampm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_am"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_selector_orange_btn"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="오전"
            android:textColor="@color/selector_text_orange_to_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rb_pm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_selector_orange_btn"
            android:button="@null"
            android:gravity="center"
            android:text="오후"
            android:textColor="@color/selector_text_orange_to_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/nanum_gothic_bold"
        android:text="시"
        android:textColor="#FF8A4C"
        android:textSize="16sp" />

    <GridLayout
        android:id="@+id/grid_hour"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alignmentMode="alignBounds"
        android:columnCount="6"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_1" android:text="1" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_2" android:text="2" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_3" android:text="3" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_4" android:text="4" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_5" android:text="5" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_6" android:text="6" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_7" android:text="7" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_8" android:text="8" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_9" android:text="9" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_10" android:text="10" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_11" android:text="11" />
        <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_hour_12" android:text="12" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/nanum_gothic_bold"
                android:text="분"
                android:textColor="#FF8A4C"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_min_00" android:text="00" android:layout_marginEnd="16dp" />
                <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_min_30" android:text="30" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/nanum_gothic_bold"
                android:text="휴무"
                android:textColor="#FF8A4C"
                android:textSize="16sp" />

            <RadioButton style="@style/CircleTimeButton" android:id="@+id/rb_holiday" android:text="휴" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_apply_time"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#FF8A4C"
        android:fontFamily="@font/nanum_gothic_bold"
        android:text="적용"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:cornerRadius="8dp" />

</LinearLayout>