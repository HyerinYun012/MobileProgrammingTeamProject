<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_border_orange"
    android:padding="16dp">

    <!-- 게시글 / 댓글 타입 뱃지 -->
    <TextView
        android:id="@+id/tv_type_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edit_orange"
        android:backgroundTint="#FF8A4C"
        android:fontFamily="@font/nanum_gothic_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="게시글"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 신고자 -->
    <TextView
        android:id="@+id/tv_reporter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/nanum_gothic_bold"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_type_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_type_badge"
        app:layout_constraintTop_toTopOf="@id/tv_type_badge" />

    <!-- 신고 사유 -->
    <TextView
        android:id="@+id/tv_reason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/nanum_gothic_regular"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_type_badge" />

    <!-- 상태 + 날짜 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/nanum_gothic_regular"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reason" />

    <!-- 삭제 버튼 -->
    <TextView
        android:id="@+id/btn_delete_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_solid_orange"
        android:backgroundTint="#ED0000"
        android:fontFamily="@font/nanum_gothic_bold"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:text="삭제"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/btn_complete_report"
        app:layout_constraintTop_toBottomOf="@id/tv_status" />

    <!-- 처리완료 버튼 -->
    <TextView
        android:id="@+id/btn_complete_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_solid_orange"
        android:fontFamily="@font/nanum_gothic_bold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="완료처리"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_status" />

</androidx.constraintlayout.widget.ConstraintLayout>
