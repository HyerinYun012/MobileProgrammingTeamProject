<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="펫플레이스 프론트 테스트"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btn_test_review_read"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="리뷰 읽기/쓰기 화면"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_pet_manage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="고객 모드 (반려동물 등록)"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_owner"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="사장님 모드 (리뷰 관리)"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_store_manage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="사장님 모드 (업장 등록/관리)"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_menu_manage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="사장님 모드 (메뉴 관리)"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_notice_manage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="사장님 모드 (공지 관리)"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_customer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="고객 모드 (내 리뷰)"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D9D9D9"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_test_admin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="관리자 모드 (마이페이지)"
            android:backgroundTint="#FF8A4C"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_add_biz"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="사업자가입신청 임시 데이터 넣기"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_test_add_inquiry"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="1:1 문의 임시 데이터 넣기"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>