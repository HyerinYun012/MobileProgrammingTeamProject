        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/selector_text_orange_to_white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="DaySelectionCheckbox">
        <item name="android:layout_width">35dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:layout_margin">2.3dp</item>
        <item name="android:background">@drawable/bg_circle_selector</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/selector_text_orange_to_white</item>
        <item name="android:textSize">16sp</item>
